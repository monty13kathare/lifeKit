# Copy to `.env` and fill in. `.env` is git-ignored; this example file is committed.

# Google Gemini API key (https://aistudio.google.com/apikey). Server-only — never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional: Gemini model (default: gemini-3.5-flash-lite).
# GEMINI_MODEL=gemini-3.8-flash

# Optional: use an external translation proxy instead of Gemini. POST { text, from, to } -> { text }.
# NEXT_PUBLIC_TRANSLATION_ENDPOINT=https://example.com/translate
